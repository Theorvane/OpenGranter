{
  "name": "opengranter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts package.json tsconfig.json biome.json",
    "format": "biome check --write src test scripts package.json tsconfig.json biome.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && python3 scripts/check.py && npm run compatibility:check",
    "compatibility:check": "node --experimental-strip-types scripts/check-openrouter-schema.ts",
    "compatibility:drift": "node --experimental-strip-types scripts/check-openrouter-schema.ts --live"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@openrouter/sdk": "1.4.18",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "openai": "7.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
