{
  "version": 1,
  "cases": [
    {"id": "unauthenticated", "request": "POST /v1/chat/completions", "condition": "No credential", "expected_status": 401, "upstream_called": false, "audit_action": "auth.denied"},
    {"id": "unauthorized-model", "request": "POST /v1/chat/completions", "condition": "Authenticated without model invocation permission", "expected_status": 403, "upstream_called": false, "audit_action": "llm.denied"},
    {"id": "unknown-model", "request": "POST /v1/chat/completions", "condition": "Unknown model alias", "expected_status": 404, "upstream_called": false, "audit_action": "llm.denied"},
    {"id": "successful-delegated-call", "request": "POST /v1/chat/completions", "condition": "Authorized delegated route; OpenRouter succeeds", "route_kind": "delegated", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"},
    {"id": "successful-managed-call", "request": "POST /v1/chat/completions", "condition": "Authorized managed route; registered direct provider succeeds", "route_kind": "managed", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"},
    {"id": "managed-selects-approved-provider", "request": "POST /v1/chat/completions", "condition": "Two direct-provider routes are configured; the selection rule chooses an authorized destination and records its route ID", "route_kind": "managed", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"},
    {"id": "delegated-provider-denied", "request": "POST /v1/chat/completions", "condition": "Model is allowed but all possible OpenRouter inference providers are denied", "route_kind": "delegated", "expected_status": 403, "upstream_called": false, "audit_action": "llm.denied"},
    {"id": "delegated-provider-bounded", "request": "POST /v1/chat/completions", "condition": "Only one OpenRouter inference provider is authorized; server-generated provider.only contains only that provider", "route_kind": "delegated", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"},
    {"id": "managed-same-kind-fallback", "request": "POST /v1/chat/completions", "condition": "First direct provider fails before response starts; second previously authorized direct provider succeeds", "route_kind": "managed", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"},
    {"id": "no-cross-kind-fallback", "request": "POST /v1/chat/completions", "condition": "Delegated route fails and only a managed route remains; no managed attempt is made", "route_kind": "delegated", "expected_status": 502, "upstream_called": true, "audit_action": "llm.failed"},
    {"id": "unbounded-routing-override", "request": "POST /v1/chat/completions", "condition": "Delegated route includes an unevaluated fallback model or destination", "route_kind": "delegated", "expected_status": 400, "upstream_called": false, "audit_action": "llm.denied"},
    {"id": "disabled-route", "request": "POST /v1/chat/completions", "condition": "Requested model alias has no enabled approved route", "expected_status": 403, "upstream_called": false, "audit_action": "llm.denied"},
    {"id": "upstream-failure", "request": "POST /v1/chat/completions", "condition": "Authorized route; upstream returns 5xx", "expected_status": 502, "upstream_called": true, "audit_action": "llm.failed"},
    {"id": "self-usage-read", "request": "GET /v1/usage", "condition": "Authenticated principal has usage:ReadSelf on their own principal resource", "expected_status": 200, "upstream_called": false, "audit_action": "usage.read"},
    {"id": "denied-usage-read", "request": "GET /v1/usage", "condition": "Principal has no usage:ReadSelf Allow or has an explicit Deny", "expected_status": 403, "upstream_called": false, "audit_action": "usage.read.denied"},
    {"id": "target-usage-read", "request": "GET /v1/usage", "condition": "A specified principal_id has usage:ReadAll Allow on that target", "expected_status": 200, "upstream_called": false, "audit_action": "usage.read"},
    {"id": "filtered-usage-read", "request": "GET /v1/usage", "condition": "With model=chat, from_ms=100, and to_ms=101, an authorized reader receives only their target principal's matching alias and inclusive/exclusive time range", "expected_status": 200, "upstream_called": false, "audit_action": "usage.read"},
    {"id": "out-of-filter-usage-row", "request": "GET /v1/usage", "condition": "The ledger returns an otherwise valid row with a different model alias", "expected_status": 503, "upstream_called": false, "audit_action": "usage.read.unavailable"},
    {"id": "csv-usage-page", "request": "GET /v1/usage", "condition": "With format=csv, an authorized reader downloads only the same scoped page and receives explicit continuation headers", "expected_status": 200, "upstream_called": false, "audit_action": "usage.read"},
    {"id": "csv-usage-denied", "request": "GET /v1/usage", "condition": "With format=csv, absent or explicit-denied usage permission stops before storage and export", "expected_status": 403, "upstream_called": false, "audit_action": "usage.read.denied"},
    {"id": "cross-principal-usage-row", "request": "GET /v1/usage", "condition": "The ledger returns a row for another principal", "expected_status": 503, "upstream_called": false, "audit_action": "usage.read.unavailable"},
    {"id": "self-audit-read", "request": "GET /v1/audit", "condition": "Authenticated principal has audit:Read on their own principal resource", "expected_status": 200, "upstream_called": false, "audit_action": "audit.history.read"},
    {"id": "denied-audit-read", "request": "GET /v1/audit", "condition": "Principal has no audit:Read Allow or has an explicit Deny on the target", "expected_status": 403, "upstream_called": false, "audit_action": "audit.history.read.denied"},
    {"id": "target-audit-read", "request": "GET /v1/audit", "condition": "A specified principal_id has audit:Read Allow on that target", "expected_status": 200, "upstream_called": false, "audit_action": "audit.history.read"},
    {"id": "ranged-audit-read", "request": "GET /v1/audit", "condition": "With from_ms=1000 and to_ms=1001, an authorized audit reader receives only target-principal events in the inclusive/exclusive range", "expected_status": 200, "upstream_called": false, "audit_action": "audit.history.read"},
    {"id": "out-of-range-audit-row", "request": "GET /v1/audit", "condition": "The reader returns an otherwise valid event outside the requested occurrence-time range", "expected_status": 503, "upstream_called": false, "audit_action": "audit.history.read.unavailable"},
    {"id": "cross-principal-audit-row", "request": "GET /v1/audit", "condition": "The audit reader returns a row for another principal", "expected_status": 503, "upstream_called": false, "audit_action": "audit.history.read.unavailable"},
    {"id": "ordered-managed-without-jev", "request": "POST /v1/chat/completions", "condition": "Managed route omits Jev settings and invokes the first IAM-eligible candidate in administrator order", "route_kind": "managed", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"},
    {"id": "ordered-managed-denied-provider", "request": "POST /v1/chat/completions", "condition": "First managed candidate has a final-provider Deny and the second candidate is allowed", "route_kind": "managed", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"},
    {"id": "malformed-jev-route", "request": "POST /v1/chat/completions", "condition": "A managed route explicitly supplies malformed Jev settings", "route_kind": "managed", "expected_status": 503, "upstream_called": false, "audit_action": "llm.denied"},
    {"id": "base64url-credential-audit", "request": "POST /v1/chat/completions", "condition": "An authorized issued token has a canonical credential ID starting with - or _; required audit succeeds", "route_kind": "managed", "expected_status": 200, "upstream_called": true, "audit_action": "llm.invoked"}
  ]
}
